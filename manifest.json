{
  "manifest_version": 3,
  "name": "OLX & Standvirtual Dark",
  "version": "0.2.1",
  "description": "Dark theme for OLX.pt and Standvirtual.com. One button to turn it on and off.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://olx.pt/*",
    "*://www.olx.pt/*",
    "*://m.olx.pt/*",
    "*://standvirtual.com/*",
    "*://www.standvirtual.com/*",
    "*://m.standvirtual.com/*",
    "*://login.standvirtual.com/*"
  ],
  "action": {
    "default_title": "Dark theme",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
